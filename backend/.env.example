# 应用配置
APP_NAME=UI-Automation
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# 服务配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
# 开发环境使用SQLite（默认），无需配置MySQL
USE_SQLITE=True
SQLITE_PATH=data/ui_automation.db

# 生产环境MySQL配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ui_automation
DB_ECHO=False

# 日志配置
LOG_LEVEL=INFO
LOG_PATH=logs

# 文件上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Agent配置（预留）
AGENT_TYPE=mock
AGENT_TIMEOUT=300

# AI服务配置（预留）
# UI-TARS配置
UITARS_API_KEY=
UITARS_API_URL=

# DeepSeek配置
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=

# Ollama配置
OLLAMA_HOST=http://localhost:11434

# 向量数据库配置（预留）
MILVUS_HOST=localhost
MILVUS_PORT=19530

# 图数据库配置（预留）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== R2R / AnythingChat 知识服务配置 =====
# 知识提供者: r2r | local(使用内置Milvus)
KNOWLEDGE_PROVIDER=r2r
# AnythingChat / R2R 服务地址
R2R_BASE_URL=http://localhost:7272
# R2R API Key（可选，生产环境必须配置）
R2R_API_KEY=
