# ================================================================== #
#  Test-Automation 环境变量配置                                      #
#  复制此文件为 .env 并修改对应值                                     #
# ================================================================== #

# ---------- 应用配置 ----------
APP_NAME=Test-Automation
APP_VERSION=1.0.0
USE_SQLITE=False
APP_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# 安全配置（生产环境必须修改）
SECRET_KEY=change-this-to-a-random-secret-key

# ---------- MySQL 数据库 ----------
# Docker 模式: DB_HOST=mysql, DB_PORT=3306（容器内通信）
# 裸机模式:   DB_HOST=localhost, DB_PORT=3307（宿主映射端口）
# 注意: docker-compose.yml 将 MySQL 映射到宿主机 3307 端口
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=magic1212
DB_NAME=test_automation
DB_ECHO=False

# ---------- Redis ----------
REDIS_ENABLED=True
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Milvus 向量数据库 ----------
MILVUS_HOST=milvus
MILVUS_PORT=19530
# 设为 1 强制使用 Standalone 模式（Docker 部署必须）
MILVUS_STANDALONE=1

# ---------- Neo4j 图数据库 ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password

# ---------- AI 模型 API ----------
# 通义千问（DashScope）— 核心 LLM + Embedding
QWEN_API_KEY=sk-your-dashscope-api-key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-vl-plus

# Embedding 配置
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# UI-TARS（可选）
UITARS_API_KEY=
UITARS_API_URL=

# DeepSeek（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=

# Ollama 本地模型（可选）
OLLAMA_HOST=http://ollama:11434

# ---------- 知识服务（可选） ----------
KNOWLEDGE_PROVIDER=r2r
R2R_BASE_URL=http://localhost:7272
R2R_API_KEY=

# ---------- 文件与日志 ----------
LOG_LEVEL=INFO
LOG_PATH=logs
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
REPORT_DIR=reports

# ---------- Agent 配置 ----------
AGENT_TYPE=mock
AGENT_TIMEOUT=300

# ---------- Playwright 浏览器 ----------
# Docker 内 Chromium 路径
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# 使用本机 Chrome（留空则用 Playwright 内置 Chromium）
# Windows: C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
PLAYWRIGHT_CHROME_PATH=
PLAYWRIGHT_HEADLESS=True
