# ================================================================== #
#  Test-Automation 后端环境变量（本地开发用）                          #
#  Docker 部署请使用项目根目录的 .env                                #
# ================================================================== #

# 应用配置
APP_NAME=Test-Automation
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# 安全配置
SECRET_KEY=dev-secret-key-change-in-production

# 数据库配置
# 本地开发: USE_SQLITE=True 用 SQLite，或 USE_SQLITE=False 用 MySQL
# 如果本地装了 MySQL，设置 USE_SQLITE=False 并填写 MySQL 连接信息
USE_SQLITE=False
DB_HOST=localhost
DB_PORT=3307          # Docker 映射端口；本地直装 MySQL 用 3306
DB_USER=root
DB_PASSWORD=magic1212
DB_NAME=test_automation
DB_ECHO=False

# SQLite 备用（USE_SQLITE=True 时生效）
SQLITE_PATH=data/test_automation.db

# Redis 配置
REDIS_ENABLED=True
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_STANDALONE=1

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password

# 通义千问（DashScope）— 核心 LLM + Embedding
QWEN_API_KEY=sk-your-dashscope-api-key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-vl-plus

# Embedding 配置
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# 其他 AI 服务（可选）
UITARS_API_KEY=
UITARS_API_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=
OLLAMA_HOST=http://localhost:11434

# 知识服务（可选）
KNOWLEDGE_PROVIDER=r2r
R2R_BASE_URL=http://localhost:7272
R2R_API_KEY=

# 日志配置
LOG_LEVEL=INFO
LOG_PATH=logs

# 文件上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
REPORT_DIR=reports

# Agent 配置
AGENT_TYPE=mock
AGENT_TIMEOUT=300

# Playwright 浏览器
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
# 使用本机 Chrome（留空则用 Playwright 内置 Chromium）
# Windows: C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
PLAYWRIGHT_CHROME_PATH=
PLAYWRIGHT_HEADLESS=True
