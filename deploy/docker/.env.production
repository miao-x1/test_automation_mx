# ================================================================== #
#  生产环境变量模板                                                   #
#                                                                    #
#  使用方式:                                                          #
#    cp .env.production .env                                         #
#    # 必须把 SECRET_KEY / DB_PASSWORD / NEO4J_PASSWORD 改成非默认值   #
#    # 否则后端生产启动会失败                                          #
#    # 修改下方敏感配置后:                                            #
#    docker compose -f deploy/docker/docker-compose.prod.yml up -d   #
# ================================================================== #

# ===== 应用配置 =====
APP_NAME=Test-Automation
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=False
SECRET_KEY=CHANGE-ME-TO-A-RANDOM-64-CHAR-STRING
CORS_ORIGINS=http://localhost
ENABLE_DOCS=False
ALLOW_REGISTER=True
REGISTER_REQUIRE_APPROVAL=False
CAPTCHA_REQUIRED=True
SMS_PROVIDER=console
SMS_ECHO_CODE=False
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
AUTH_REQUIRED=True
ENABLE_MCP=False
COOKIE_SECURE=True
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LLM_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10
ADMIN_USERNAME=
ADMIN_PASSWORD=
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_PATH=logs
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
REPORT_DIR=reports

# ===== MySQL 数据库 =====
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=magic1212
DB_NAME=test_automation
DB_ECHO=False
USE_SQLITE=False

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=True

# ===== Milvus 向量数据库 =====
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_STANDALONE=1
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ===== Neo4j 图数据库 =====
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ===== LLM 配置 (生产环境必须配置真实 API Key) =====
QWEN_API_KEY=sk-your-dashscope-api-key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-vl-plus

DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# LLM Gateway
LLM_GATEWAY_ENABLED=True
LLM_GATEWAY_DEFAULT_CHAIN=default
LLM_GATEWAY_FALLBACK_CHAIN=qwen:qwen-plus,deepseek:deepseek-chat,ollama:qwen2.5:7b,mock:mock-model
LLM_GATEWAY_CIRCUIT_THRESHOLD=3
LLM_GATEWAY_CIRCUIT_COOLDOWN=60
LLM_GATEWAY_LOG_ENABLED=True

# ===== Agent 配置 =====
AGENT_TYPE=autogen
AGENT_TIMEOUT=300
WORKER_CONCURRENCY=4
# WORKER_ID=worker-01  # 多 Worker 部署时设置唯一 ID

# ===== 知识服务 (可选；默认 local) =====
KNOWLEDGE_PROVIDER=local
R2R_BASE_URL=http://localhost:7272
R2R_API_KEY=

# ===== 前端端口 (Docker 映射) =====
FRONTEND_PORT=80
BACKEND_PORT=8000
DB_PORT=3307
REDIS_PORT=6379
MILVUS_PORT=19530
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ===== Playwright =====
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
